# Copy to .env and paste the key from the challenge PDF. Never commit .env.
OPENAI_API_KEY=

# Models (the challenge mandates gpt-4o-mini).
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Retrieval tuning.
CHUNK_SIZE=1000          # characters, not tokens
CHUNK_OVERLAP=150
TOP_K=5                  # chunks, not pages

# Input limits.
MAX_QUESTIONS=50
MAX_QUESTION_CHARS=2000

# Generation limits.
TEMPERATURE=0.0
MAX_ANSWER_TOKENS=500
REQUEST_TIMEOUT=30       # seconds per HTTP call
MAX_RETRIES=2            # bounded, so a retry loop cannot burn the budget

# The literal abstention string callers can filter on.
FALLBACK=Data Not Available
